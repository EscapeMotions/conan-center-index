diff --git a/src/plugins/platforms/cocoa/qnsview_tablet.mm b/src/plugins/platforms/cocoa/qnsview_tablet.mm
--- a/src/plugins/platforms/cocoa/qnsview_tablet.mm
+++ b/src/plugins/platforms/cocoa/qnsview_tablet.mm
@@ -84,6 +84,18 @@
 
     bool down = (eventType != NSEventTypeMouseMoved);
 
+    // m_buttons is only updated by the mouse down/up handlers. If an up event never arrives (seen
+    // with a pen side button), the button stays recorded and every later pen lift becomes a release
+    // that still holds it, so the tablet target is never released. A hover move while the system
+    // reports no mouse button pressed can't have a button held. Down and drag events never clear
+    // it: some drivers send the tip-down with zero pressure and no buttonMask, which would drop the
+    // press and turn the whole stroke into hover moves.
+    if (m_buttons != Qt::NoButton && eventType == NSEventTypeMouseMoved && [NSEvent pressedMouseButtons] == 0) {
+        qCDebug(lcQpaTablet) << "clearing stale buttons" << m_buttons << "on a hover move";
+        m_buttons = Qt::NoButton;
+        m_sendUpAsRightButton = false;
+    }
+
     qreal pressure;
     if (down) {
         pressure = [theEvent pressure];
